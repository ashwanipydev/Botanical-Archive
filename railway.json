{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "backend": {
      "name": "zoo-backend",
      "source": {
        "root": "backend"
      },
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "startCommand": "java -jar target/*.jar"
      }
    },
    "frontend": {
      "name": "zoo-frontend",
      "source": {
        "root": "frontend"
      },
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "startCommand": "npm start"
      }
    }
  }
}
